# =============================================================
# TimeStamp Proxy — Variables de Entorno
# Copiar como .env y rellenar con valores reales
# NUNCA commitear el .env real al repositorio
# =============================================================

# ----------------------------
# GENERAL
# ----------------------------
ENVIRONMENT=production          # development | production
LOG_LEVEL=info                  # debug | info | warn | error
APP_VERSION=1.0.0

# ----------------------------
# BACKEND
# ----------------------------
BACKEND_PORT=8080
BACKEND_READ_TIMEOUT=30s
BACKEND_WRITE_TIMEOUT=30s
BACKEND_IDLE_TIMEOUT=120s
BACKEND_SHUTDOWN_TIMEOUT=15s

# JWT — generar con: openssl rand -hex 32
JWT_SECRET=CHANGE_ME_openssl_rand_hex_32
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=168h            # 7 días

# ----------------------------
# POSTGRES
# ----------------------------
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=tsaproxy
POSTGRES_USER=tsaproxy
POSTGRES_PASSWORD=CHANGE_ME_strong_password
POSTGRES_SSL_MODE=disable
POSTGRES_MAX_OPEN_CONNS=25
POSTGRES_MAX_IDLE_CONNS=5
POSTGRES_CONN_MAX_LIFETIME=5m

# ----------------------------
# REDIS
# ----------------------------
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=CHANGE_ME_redis_password
REDIS_DB=0
REDIS_MAX_RETRIES=3
REDIS_DIAL_TIMEOUT=5s
REDIS_READ_TIMEOUT=3s
REDIS_WRITE_TIMEOUT=3s
REDIS_POOL_SIZE=10

# ----------------------------
# TSA UPSTREAM EXTERNA
# Estas credenciales NUNCA van a la base de datos
# ----------------------------
TSA_UPSTREAM_URL=https://upstream-tsa-provider.example.com/tsa
TSA_UPSTREAM_USERNAME=your_upstream_username
TSA_UPSTREAM_PASSWORD=your_upstream_password
TSA_UPSTREAM_TIMEOUT=10s
TSA_UPSTREAM_MAX_RETRIES=1
TSA_UPSTREAM_MAX_BODY_BYTES=32768   # 32KB

# ----------------------------
# RATE LIMITING GLOBAL
# ----------------------------
RATE_LIMIT_GLOBAL_RPS=200           # requests/segundo para todo el sistema
RATE_LIMIT_BURST_WINDOW=60          # segundos de ventana para burst por tenant

# ----------------------------
# PROXY PÚBLICO
# ----------------------------
PROXY_MAX_REQUEST_BODY=16384        # 16KB máximo para un TimeStampRequest
PROXY_USAGE_RECORD_ASYNC=true       # Registrar uso en goroutine async

# ----------------------------
# FRONTEND
# ----------------------------
NEXT_PUBLIC_API_URL=https://ast.bigdavi.com
NEXT_PUBLIC_APP_NAME=BIGDAVI - Panel de Administración TSA

# ----------------------------
# NGINX / TLS
# ----------------------------
# Dominio del proxy público
TSA_DOMAIN=tsa.bigdavi.com
# Dominio del panel admin
ADMIN_DOMAIN=ast.bigdavi.com

# ----------------------------
# POSTGRES (para scripts de backup)
# ----------------------------
BACKUP_DEST_DIR=/var/backups/tsaproxy
BACKUP_RETENTION_DAYS=30
